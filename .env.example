# =========================================================================
# FORGITY STUDIO - LOCAL / DOCKER COMPOSE CONFIGURATION
# Copy file này thành `.env` để sử dụng cho `docker-compose.yml`
# =========================================================================

# Thông tin chung
PROJECT_NAME=forgity
ENV_MODE=dev

# Cấu hình PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DATABASE=Forgity

# Cấu hình RabbitMQ Broker
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
