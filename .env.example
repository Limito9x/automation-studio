# ==========================================
# Forgity Studio - Environment Variables Example
# Sao chép file này thành .env và điền các giá trị phù hợp
# ==========================================

# Thông tin chung
PROJECT_NAME=forgity
ENV_MODE=prod

# Cấu hình DB Local Docker
POSTGRES_USER=postgres
POSTGRES_DATABASE=Forgity
POSTGRES_PASSWORD=your_secure_password_here

# External Service Local Docker
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Bảo mật & Token (Production / Docker)
JWT_SECRET=YOUR_MIN_32_CHARS_BASE64_SECRET_KEY
SECURITY_ENCRYPTION_KEY=YOUR_32_BYTES_HEX_ENCRYPTION_KEY

# Cloudflare R2 Storage (Nếu dùng R2)
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_SERVICE_URL=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# SMTP Email
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# TickerQ Dashboard
TICKERQ_PASSWORD=your_dashboard_password
