      <ProjectReference Include="..\Modules\Platform\Automation.Platform\Automation.Platform.csproj" />
      <ProjectReference Include="..\Modules\Projects\Automation.Projects\Automation.Projects.csproj" />
      <ProjectReference Include="..\Modules\Content\Automation.Content\Automation.Content.csproj" />
      <ProjectReference Include="..\Modules\Tag\Automation.Tag\Automation.Tag.csproj" />
      <ProjectReference Include="..\Modules\Workspace\Automation.Workspace\Automation.Workspace.csproj" />
      <ProjectReference Include="..\Modules\Pipeline\Automation.Pipeline\Automation.Pipeline.csproj" />
      <ProjectReference Include="..\Modules\DynamicForms\Automation.DynamicForms\Automation.DynamicForms.csproj" />
      <ProjectReference Include="..\Modules\DynamicForms\Automation.DynamicForms.Contracts\Automation.DynamicForms.Contracts.csproj" />
