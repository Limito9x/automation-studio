{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/log-.txt",
                "rollingInterval": "Day",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "AllowedHosts": "*",
  "RunnerBootstrap": {
    "ArtifactDirectory": "runner-bootstrap",
    "PublicApiUrl": ""
  },
  "Jwt": {
    "Secret": "CHANGE_ME_JWT_SECRET_KEY_MIN_32_BYTES_LONG",
    "Issuer": "forgity-api",
    "Audience": "forgity-client",
    "ExpiryInMinutes": 60
  },
  "Security": {
    "EncryptionKey": "CHANGE_ME_ENCRYPTION_KEY_32_BYTES_HEX_STRING"
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "SegmentsPerWindow": 12,
      "QueueLimit": 2,
      "WindowInSeconds": 60
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=Automation;Username=postgres;Password=postgres",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "CloudflareR2": {
    "AccessKey": "CHANGE_ME_R2_ACCESS_KEY",
    "SecretKey": "CHANGE_ME_R2_SECRET_KEY",
    "ServiceUrl": "https://<account_id>.r2.cloudflarestorage.com",
    "BucketName": "forgity-storage-bucket",
    "PublicBaseUrl": "https://pub-<hash>.r2.dev"
  },
  "TickerQ": {
    "BasicAuth": {
      "Username": "admin",
      "Password": "CHANGE_ME_TICKERQ_PASSWORD"
    }
  },
  "AppConfig": {
    "Name": "Forgity Studio",
    "Description": "Digital Content Creation Automation Studio Engine & API",
    "Version": "1.0.0",
    "ClientUrl": "http://localhost:5173",
    "Email": {
      "RealEmailSend": false,
      "DefaultEmail": "forgity.studio@gmail.com"
    }
  },
  "Smtp": {
    "Username": "forgity.studio@gmail.com",
    "From": "forgity.studio@gmail.com",
    "Password": "CHANGE_ME_SMTP_PASSWORD",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": "5672",
    "Username": "guest",
    "VirtualHost": "/",
    "Password": "guest",
    "ManagementPort": 15672,
    "ManagementScheme": "http"
  }
}